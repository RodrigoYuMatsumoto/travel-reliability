{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "purpose",
    "domains",
    "capabilities",
    "fields",
    "acceptanceCriteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "flight",
          "ground",
          "lodging",
          "itinerary",
          "documents",
          "insurance",
          "health",
          "accessibility",
          "points",
          "rights",
          "evidence",
          "risk",
          "group",
          "budget",
          "calendar",
          "monitoring",
          "operations",
          "ecosystem",
          "geography",
          "culture",
          "business",
          "rail",
          "water",
          "entry",
          "connectors",
          "all"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web_research",
          "private_files",
          "calendar_read",
          "calendar_write",
          "notifications",
          "background_schedule",
          "code_execution",
          "provider_status",
          "email_read",
          "account_read",
          "file_organize"
        ]
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "type",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "boolean",
                  "date"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "type",
              "required",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "const": "enum"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                }
              }
            }
          }
        ]
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
      }
    }
  }
}
