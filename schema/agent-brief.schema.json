{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pseudonymous travel agent intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tripKey",
    "request",
    "language"
  ],
  "properties": {
    "tripKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "request": {
      "enum": [
        "plan",
        "compare",
        "group",
        "change",
        "cancel",
        "disruption",
        "corporate",
        "organize",
        "itinerary",
        "documents",
        "insurance",
        "health",
        "accessibility",
        "points",
        "rights",
        "evidence",
        "risk",
        "calendar",
        "monitor",
        "resume",
        "deliver",
        "audit",
        "ecosystem"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,12}$"
    },
    "domain": {
      "enum": [
        "flight",
        "ground",
        "lodging",
        "itinerary",
        "documents",
        "insurance",
        "health",
        "accessibility",
        "points",
        "rights",
        "evidence",
        "risk",
        "group",
        "budget",
        "calendar",
        "monitoring",
        "operations",
        "ecosystem",
        "geography",
        "culture",
        "business",
        "rail",
        "water",
        "entry",
        "connectors",
        "all",
        null
      ]
    },
    "workflowId": {
      "enum": [
        "flex-dates",
        "airports",
        "connections",
        "promotions",
        "total-cost",
        "fare-scenarios",
        "negotiation",
        "hidden-city",
        "group-split",
        "host-capabilities",
        "resume-trip",
        "prepurchase-comparison",
        "extract-bookings",
        "trip-intake",
        "audit-logistics",
        "trip-record",
        "compare-lodging",
        "compare-rentals",
        "compare-attractions",
        "points-strategy",
        "build-itinerary",
        "departure-checklist",
        "accessibility-plan",
        "hybrid-travel",
        "personal-commitments",
        "emergency-plan",
        "weather-contingency",
        "audit-itinerary",
        "calendar-plan",
        "deliver-trip",
        "organize-documents",
        "manage-risk",
        "consumer-rights",
        "monitor-trip",
        "task-board",
        "planned-vs-actual",
        "multi-trip",
        "ecosystem-setup",
        "evaluate-agent",
        "scheduled-review",
        "code-workbench",
        "cowork-workbench",
        "chat-guidance",
        "ground-transport",
        "travel-documents",
        "insurance-review",
        "health-plan",
        "supplier-verification",
        "listing-review",
        "claim-dossier",
        "expense-settlement",
        "route-data",
        "global-context",
        "geography-route-check",
        "history-culture-context",
        "local-customs-etiquette",
        "professional-trip-plan",
        "business-negotiation",
        "reconcile-reservations",
        "connect-account-sources",
        "document-workspace-plan",
        "document-workspace-apply",
        "ecosystem-extension",
        "rail-ferry-cruise-plan",
        "border-entry-plan",
        "travel-purpose-plan",
        null
      ]
    },
    "groupMode": {
      "enum": [
        "planning",
        "expenses_only",
        null
      ]
    },
    "incident": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceKind": {
          "enum": [
            "flight",
            "bus",
            "lodging",
            "tour",
            "rental",
            "other",
            null
          ]
        },
        "kind": {
          "enum": [
            "delay",
            "cancellation",
            "denied_boarding",
            "baggage",
            "service_issue",
            "refund",
            "other",
            null
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scheduledAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ongoing": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "origin": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "destination": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "departureDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "returnTrip": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "returnDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "party": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "not": {
        "type": "object",
        "required": [
          "adults",
          "children",
          "infants"
        ],
        "properties": {
          "adults": {
            "const": 0
          },
          "children": {
            "const": 0
          },
          "infants": {
            "const": 0
          }
        }
      },
      "properties": {
        "adults": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "children": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "infants": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "households": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "budget": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minorUnits",
            "currency"
          ],
          "properties": {
            "minorUnits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "scope": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      ]
    },
    "mustHaves": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "step_free",
          "stroller",
          "checked_bag",
          "car_seat",
          "flexible_cancellation",
          "stable_internet",
          "no_separate_tickets"
        ]
      }
    }
  }
}
