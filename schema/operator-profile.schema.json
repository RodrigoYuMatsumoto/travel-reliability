{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "exposeWorkspaceNames": {
      "type": "boolean"
    },
    "gmail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedScopes",
        "bindings"
      ],
      "properties": {
        "maxReads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "approvedScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tripKey",
              "recordKeys"
            ],
            "properties": {
              "tripKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "recordKeys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]{1,39}$"
                }
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tripKey",
              "recordKey",
              "messageId",
              "sourceRef",
              "providerKey"
            ],
            "properties": {
              "tripKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "recordKey": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]{1,39}$"
              },
              "messageId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "sourceRef": {
                "type": "string",
                "pattern": "^SRC[0-9]{2,6}$"
              },
              "providerKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,39}$"
              }
            }
          }
        }
      }
    }
  }
}
