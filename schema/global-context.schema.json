{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tripKey",
    "language",
    "locale",
    "currencies",
    "baseCurrency",
    "unitSystem",
    "purposes",
    "locations",
    "segments"
  ],
  "properties": {
    "tripKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,12}$"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,12}$"
    },
    "currencies": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      ]
    },
    "baseCurrency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "unitSystem": {
      "enum": [
        "metric",
        "us",
        "uk",
        null
      ]
    },
    "purposes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "leisure",
              "business",
              "hybrid",
              "education",
              "medical",
              "pilgrimage",
              "event",
              "family",
              "volunteer",
              "relocation",
              "adventure",
              "other"
            ]
          }
        }
      ]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "countryCode",
          "administrativeArea",
          "municipalityKey",
          "timeZone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "countryCode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$"
          },
          "administrativeArea": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 6,
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          },
          "municipalityKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeZone": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^(?:UTC|[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+){1,2})$"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "from",
          "to",
          "departure",
          "arrival",
          "minimumConnectionMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "mode": {
            "enum": [
              "flight",
              "bus",
              "rail",
              "ferry",
              "cruise",
              "car",
              "rental_car",
              "transfer",
              "taxi",
              "rideshare",
              "bicycle",
              "walking",
              "hotel",
              "vacation_rental",
              "hostel",
              "camping",
              "motorhome",
              "activity",
              "meeting",
              "event",
              "other"
            ]
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "departure": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "localDateTime",
                  "utcOffset"
                ],
                "properties": {
                  "localDateTime": {
                    "type": "string",
                    "maxLength": 19,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]$"
                  },
                  "utcOffset": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 6,
                    "pattern": "^(?:Z|[+-][0-9]{2}:[0-5][0-9])$"
                  }
                }
              }
            ]
          },
          "arrival": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "localDateTime",
                  "utcOffset"
                ],
                "properties": {
                  "localDateTime": {
                    "type": "string",
                    "maxLength": 19,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]$"
                  },
                  "utcOffset": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 6,
                    "pattern": "^(?:Z|[+-][0-9]{2}:[0-5][0-9])$"
                  }
                }
              }
            ]
          },
          "minimumConnectionMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10080
          }
        }
      }
    },
    "researchTopics": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "geography",
          "history",
          "culture",
          "customs",
          "safety",
          "accessibility",
          "entry",
          "health",
          "insurance",
          "business",
          "connectivity"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRef",
          "topic",
          "countryCode",
          "locationId",
          "segmentId",
          "observedAt",
          "validUntil"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "sourceRef": {
            "type": "string",
            "pattern": "^SRC[0-9]{2,6}$"
          },
          "topic": {
            "enum": [
              "geography",
              "history",
              "culture",
              "customs",
              "safety",
              "accessibility",
              "entry",
              "health",
              "insurance",
              "business",
              "connectivity",
              "supplier_identity",
              "conditions",
              "costs",
              "schedule",
              "baggage",
              "driving",
              "accommodation"
            ]
          },
          "countryCode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$"
          },
          "locationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "segmentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 35,
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "maxLength": 35,
                "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
