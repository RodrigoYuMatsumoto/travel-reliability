{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tripKey",
    "documents",
    "records"
  ],
  "properties": {
    "tripKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
    },
    "documents": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileId",
          "serviceType",
          "serviceDate",
          "recordId",
          "sourceRefs",
          "mode"
        ],
        "properties": {
          "fileId": {
            "type": "string",
            "pattern": "^F[a-f0-9]{24}$"
          },
          "serviceType": {
            "enum": [
              "flight",
              "bus",
              "rail",
              "ferry",
              "cruise",
              "car-rental",
              "transfer",
              "hotel",
              "short-stay",
              "camping",
              "activity",
              "insurance",
              "business",
              "other"
            ]
          },
          "serviceDate": {
            "type": "string",
            "format": "date",
            "maxLength": 10
          },
          "recordId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SRC[0-9]{2,6}$"
            }
          },
          "mode": {
            "enum": [
              "copy",
              "move"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationKey",
          "sourceRef",
          "channel",
          "serviceType",
          "fields"
        ],
        "properties": {
          "reservationKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "sourceRef": {
            "type": "string",
            "pattern": "^SRC[0-9]{2,6}$"
          },
          "channel": {
            "enum": [
              "email",
              "supplier-export",
              "booking-export",
              "airbnb-export",
              "manual"
            ]
          },
          "serviceType": {
            "enum": [
              "flight",
              "bus",
              "rail",
              "ferry",
              "cruise",
              "car-rental",
              "transfer",
              "hotel",
              "short-stay",
              "camping",
              "activity",
              "insurance",
              "business",
              "other"
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "supplierId",
              "status",
              "startsAt",
              "endsAt",
              "locationCode",
              "money"
            ],
            "properties": {
              "supplierId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "confirmed",
                  "cancelled",
                  null
                ]
              },
              "startsAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 40
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endsAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 40
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "locationCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z0-9:_-]{2,32}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "money": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "currency",
                      "amountMinor"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "amountMinor": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
